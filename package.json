    "qrcode": "^1.5.3",
    "next-auth": "^4.24.7",
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.17.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
